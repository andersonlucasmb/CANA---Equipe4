class Node:
    def __init__(self, value):
        self.value = value
        self.next = None


class LinkedList:
    def __init__(self):
        self.head = None
        self.len = 0

    def insert(self, value):
        new_node = Node(value)
        if self.head is None:
            self.head = new_node
        else:
            current = self.head
            while current.next:
                current = current.next
            current.next = new_node
        self.len += 1

    def to_array(self):
        array = []
        current = self.head
        while current:
            array.append(current.value)
            current = current.next
        return array

    def from_array(self, array):
        current = self.head
        for value in array:
            current.value = value
            current = current.next

    def display(self):
        current = self.head
        print("Lista: ", end="")
        while current:
            print(current.value, end=" -> ")
            current = current.next
        print("None")

    def shell_sort(self):
        # converte a lista encadeada para array para aplicar o shell sort
        array = self.to_array()
        n = len(array)

        h = 1
        while h <= n // 3:
            h = h * 3 + 1  # sequência: 1, 4, 13, 40, 121...

        while h > 0:
            for outer in range(h, n):
                temp = array[outer]
                inner = outer
                while inner > h - 1 and array[inner - h] >= temp:
                    array[inner] = array[inner - h]
                    inner -= h
                array[inner] = temp
            h = (h - 1) // 3  # decrementa h

        # devolve os valores ordenados para os nós da lista
        self.from_array(array)


# --- main ---
import random

ll = LinkedList()

print("Inserindo 10 valores aleatórios...")
for _ in range(10):
    value = random.randint(0, 99)
    ll.insert(value)

print("\nAntes da ordenação:")
ll.display()

ll.shell_sort()

print("\nDepois da ordenação:")
ll.display()

