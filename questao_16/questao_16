if __name__ == "__main__":
    #        1
    #       / \
    #      2   3
    #     / \
    #    4   5
    arvore = Node(1, Node(2, Node(4), Node(5)), Node(3))

    print("--- a) Número de nós ---")
    print("Recursivo: ", contar_nos_recursivo(arvore))
    print("Iterativo: ", contar_nos_iterativo(arvore))

    print("\n--- b) Soma dos nós ---")
    print("Recursivo: ", soma_nos_recursivo(arvore))
    print("Iterativo: ", soma_nos_iterativo(arvore))

    print("\n--- c) Profundidade ---")
    print("Recursivo: ", profundidade_recursivo(arvore))
    print("Iterativo: ", profundidade_iterativo(arvore))